{
	"name": "n8n-nodes-telegram-censor",
	"version": "3.0.0",
	"description": "Telegram Censor for n8n: local nudity detection and blur to prevent Telegram channel/group bans from adult content",
	"license": "MIT",
	"keywords": [
		"n8n-community-node-package",
		"telegram",
		"telegram-mtproto",
		"telegram-censor",
		"telegram-nudity-filter",
		"telegram-nsfw",
		"telegram-policy",
		"censor",
		"moderation",
		"local-ai",
		"nsfw",
		"nudenet",
		"onnx",
		"image-blur",
		"content-moderation",
		"privacy",
		"self-hosted"
	],
	"scripts": {
		"build": "n8n-node build && gulp build --silent",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"format": "prettier credentials models nodes --write",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"n8n-scan": "npx @n8n/scan-community-package n8n-nodes-telegram-censor",
		"test": "n8n-node lint && npm run build",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"author": {
		"name": "sadiakant",
		"email": "krushnakantsadiya@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sadiakant/n8n-nodes-telegram-censor.git"
	},
	"homepage": "https://github.com/sadiakant/n8n-nodes-telegram-censor#readme",
	"bugs": {
		"url": "https://github.com/sadiakant/n8n-nodes-telegram-censor/issues"
	},
	"dependencies": {
		"onnxruntime-web": "^1.24.1",
		"sharp": "^0.34.5",
		"teleproto": "^1.224.1"
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"gulp": "^5.0.1",
		"prettier": "3.8.3",
		"release-it": "20.0.1",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/TelegramCensorCredentialsApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/TelegramCensor/TelegramCensor.node.js"
		]
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=18.17.0"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public",
		"provenance": true
	}
}
